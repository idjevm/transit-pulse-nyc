# ---- Confluent Cloud: Kafka cluster ----
BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_API_KEY=your-cluster-api-key
KAFKA_API_SECRET=your-cluster-api-secret

# ---- Confluent Cloud: Schema Registry ----
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=your-sr-api-key
SCHEMA_REGISTRY_API_SECRET=your-sr-api-secret

# ---- Anthropic (dispatcher agent) ----
ANTHROPIC_API_KEY=sk-ant-...
# Fast + cheap for a streaming agent; swap to claude-sonnet-5 for richer output.
DISPATCHER_MODEL=claude-haiku-4-5-20251001

# ---- Google Gemini (optional; interactive dashboard copilots) ----
# The three dashboard copilots use Google Gemini when a Google API key is set
# (GEMINI_API_KEY / GOOGLEAI_API_KEY / GOOGLE_API_KEY) and fall back to Anthropic
# Claude otherwise. Leave these unset to stay on Claude.
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.1-pro-preview

# ---- Producer tuning ----
# Comma-separated feed keys from producers/feeds.py, or "all".
MTA_FEEDS=all
POLL_INTERVAL_SECONDS=15

# ---- MTA Bus Time: live buses with real GPS + heading (~2.7k buses) ----
# The public GTFS-RT feed currently serves data with no key. Set BUS_ENABLED=false
# for subway-only. BUS_API_KEY is optional (free from
# https://register.developer.obanyc.com) and appended when set.
BUS_ENABLED=true
BUS_API_KEY=
# Agency filter to trim the firehose: "all", or e.g. "MTA NYCT,MTABC".
BUS_AGENCIES=all

# ---- Topic names (underscore names match the Flink SQL tables) ----
TOPIC_TRIP_UPDATES=mta_trip_updates
TOPIC_VEHICLE_POSITIONS=mta_vehicle_positions
TOPIC_BUS_POSITIONS=mta_bus_positions
TOPIC_HEADWAY_ALERTS=mta_headway_alerts
TOPIC_RECOMMENDATIONS=mta_dispatcher_decisions
TOPIC_ARRIVAL_ESTIMATES=mta_arrival_estimates
TOPIC_WEATHER_EVENTS=nyc_weather_events
TOPIC_PASSENGER_SURGES=mta_passenger_surges

# ---- Consumer group ids ----
AGENT_GROUP_ID=mta-dispatcher-agent
DASHBOARD_GROUP_ID=mta-dashboard
