# Copy to deploy/deploy.env and fill in, then: ./deploy/provision.sh
# These drive the Confluent CLI provisioner. Nothing here is committed (.gitignored).

# ---- Confluent Cloud auth (OPTIONAL) ----
# If you're already logged in on your Mac (`confluent login`, browser/SSO), leave
# these blank — provision.sh reuses that session. Set them only for a fully
# non-interactive run: a Cloud resource-management API key (Console > right menu >
# Cloud API keys), created by an OrganizationAdmin.
export CONFLUENT_CLOUD_API_KEY=""
export CONFLUENT_CLOUD_API_SECRET=""

# ---- Where to build ----
export CLOUD="aws"                 # aws | gcp | azure  (Bedrock => keep aws)
export REGION="us-east-1"
export ENV_NAME="MTA-STREAMING-INTELLIGENCE"
export CLUSTER_NAME="MTA-CLUSTER"
export CLUSTER_TYPE="basic"        # basic is cheapest and enough for the demo
export POOL_NAME="MTA-FLINK-POOL"
export FLINK_MAX_CFU="10"

# ---- In-Flink LLM provider ----
# Which LLM backs the in-Flink dispatcher agent (CREATE MODEL -> CREATE AGENT ->
# AI_RUN_AGENT): "bedrock" (AWS, the F1-demo default) or "googleai" (Google AI
# Studio / Gemini). Fill in the matching block below.
export LLM_PROVIDER="bedrock"      # bedrock | googleai

# ---- Option A: AWS Bedrock (Claude)  [required if LLM_PROVIDER=bedrock] ----
# provision.sh feeds these into `confluent flink connection create --type bedrock`.
# AWS credentials with bedrock:InvokeModel on the model below.
export AWS_BEDROCK_ACCESS_KEY="your-aws-access-key"
export AWS_BEDROCK_SECRET_KEY="your-aws-secret-key"
export AWS_SESSION_TOKEN=""        # only if using temporary STS creds
# Bedrock model + region for the connection endpoint (region defaults to REGION).
export BEDROCK_REGION="us-east-1"
export BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"

# ---- Option B: Google AI / Gemini  [required if LLM_PROVIDER=googleai] ----
# Get an API key at https://aistudio.google.com/apikey (works with Gemini Pro).
# provision.sh feeds it into `confluent flink connection create --type googleai`.
export GOOGLEAI_API_KEY=""
export GEMINI_MODEL_ID="gemini-2.0-flash"    # e.g. gemini-2.0-flash, gemini-1.5-pro
# Endpoint is derived from GEMINI_MODEL_ID; override only if needed:
# export GOOGLEAI_ENDPOINT="https://generativelanguage.googleapis.com/v1/models/${GEMINI_MODEL_ID}:generateContent"

# ---- Managed HTTP Source Connector (real JSON feed ingest) ----
# Provisions a Confluent fully-managed HTTP Source Connector that polls a JSON
# endpoint into mta.service_alerts (JSON Schema in Schema Registry) — the
# "Use of Confluent Connector(s)" path, alongside the live GTFS-RT producer.
# Set the URL to any JSON feed. Example below is MTA service alerts on
# data.ny.gov (Socrata; no key needed for modest polling) — replace <dataset-id>
# with a real id from https://data.ny.gov (Export > API endpoint). Leave
# ALERTS_HTTP_URL empty (or ENABLE_HTTP_SOURCE=false) to skip the connector.
export ENABLE_HTTP_SOURCE="true"
export ALERTS_HTTP_URL=""
# Example: "https://data.ny.gov/resource/<dataset-id>.json?\$limit=200&\$order=:updated_at%20DESC"

# ---- Interactive agents (rider advisor / operator / route designer) ----
# These call Claude directly (side service, not in Flink). Written into .env.
export ANTHROPIC_API_KEY="sk-ant-..."
export DISPATCHER_MODEL="claude-haiku-4-5-20251001"
